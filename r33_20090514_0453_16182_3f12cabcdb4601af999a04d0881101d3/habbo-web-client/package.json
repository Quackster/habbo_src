{
  "name": "habbo-web-client",
  "version": "0.1.0",
  "description": "Habbo Hotel Shockwave client ported to browser (WASM + TypeScript)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "asbuild:debug": "asc assembly/index.ts --target debug --exportRuntime --outFile public/wasm/habbo.debug.wasm",
    "asbuild:release": "asc assembly/index.ts --target release --exportRuntime --outFile public/wasm/habbo.wasm --optimize",
    "asbuild": "npm run asbuild:release",
    "build:wasm": "npm run asbuild",
    "build:ts": "vite build",
    "build": "npm run build:wasm && npm run build:ts",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist public/wasm/*.wasm"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "assemblyscript": "^0.27.0",
    "eslint": "^8.50.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {},
  "keywords": [
    "habbo",
    "shockwave",
    "director",
    "lingo",
    "wasm",
    "assemblyscript",
    "retro",
    "emulator"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/habbo-web-client"
  }
}
